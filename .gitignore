# Dependencies and build output
node_modules/
dist/
.node/

# The user's database. It is personal data, never source: the schema is created by
# src/server/db.ts from code, so nothing here belongs in git - including the SQLite
# sidecars, where uncommitted writes actually live.
data/
*.db
*.db-wal
*.db-shm
*.db-journal
uploads/

# Generated by `npm run tauri:build` (tauri.conf.json beforeBuildCommand runs esbuild).
# Committing it is how the shipped desktop backend fell nine commits behind src/server.
src-tauri/resources/server/index.cjs
src-tauri/resources/server/index.js
src-tauri/resources/server/node_modules/
src-tauri/resources/server/data/
src-tauri/resources/node/
src-tauri/resources/src_server/
src-tauri/resources/src_shared/
src-tauri/target/
src-tauri/data/
src-tauri/gen/schemas/

# Tauri emits these alongside the crate
src-tauri/Cargo.lock.bak

# Emitted from src/shared rather than committed
src/shared/*.js
src/shared/*.d.ts

# Job-search artifacts: this repository is the tool, not the hunt. CVs, cover letters,
# answers and one-off database scripts are personal data and must never be staged.
Ian_Visser_*
*_CV.md
*_CoverLetter.md
*_CoverLetter.txt
*_Answers.md
cv-*.md
cv*.md
draft-*.md
insert_cl.js
save-redteam.cjs
*.pdf
*.docx

# Archives and OS noise
*.zip
Thumbs.db
.DS_Store
